DRIVERS_PCI_DIR := pci

OBJDIRS += $(DRIVERS_PCI_DIR)

$(DRIVERS_OBJ_DIR)/pci/%.o: $(DRIVERS_OBJ_DIR)/$(DRIVERS_PCI_DIR)/%.c $(DRIVERS_OBJ_DIR)/$(DRIVERS_PCI_DIR)/%.h
	@echo + cc[USER] $<
	@mkdir -p $(@D)
	$(V)$(CC) $(USER_CFLAGS) -c -o $@ $<

$(DRIVERS_OBJ_DIR)/pcidriver: $(DRIVERS_OBJ_DIR)/pci/pci.o $(OBJDIR)/lib/entry.o $(OBJDIR)/lib/libjos.a $(USER_EXTRA_OBJFILES) user/user.ld
	@echo + ld $@
	$(V)mkdir -p $(@D)
	$(V)$(LD) -o $@ $(ULDFLAGS) $(LDFLAGS) -nostdlib
    
